<%- include('partials/header') %>

<div class="row justify-content-center mt-5">
    <div class="col-md-8 text-center">
        <h1 class="display-4 fw-bold mb-4">Welcome to Fitness Gym</h1>
        <p class="lead mb-5">Manage your members, trainers, and gym operations efficiently with our all-in-one management system.</p>
        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
            <a href="/auth/login" class="btn btn-primary btn-lg px-4 gap-3">Login to Dashboard</a>
            <a href="/auth/signup" class="btn btn-outline-primary btn-lg px-4">Sign Up Now</a>
        </div>
    </div>
</div>

<div class="row mt-5 pt-5">
    <div class="col-md-4 text-center">
        <div class="p-3">
            <i class="fas fa-qrcode fa-3x text-primary mb-3"></i>
            <h3>QR Attendance</h3>
            <p>Automated attendance tracking using unique QR codes for every member.</p>
        </div>
    </div>
    <div class="col-md-4 text-center">
        <div class="p-3">
            <i class="fas fa-chart-line fa-3x text-primary mb-3"></i>
            <h3>Real-time Analytics</h3>
            <p>Monitor membership statistics, payments, and income with modern charts.</p>
        </div>
    </div>
    <div class="col-md-4 text-center">
        <div class="p-3">
            <i class="fas fa-calendar-alt fa-3x text-primary mb-3"></i>
            <h3>Trainer Scheduling</h3>
            <p>Efficiently manage trainer schedules and workout programs for members.</p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
