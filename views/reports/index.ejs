<%- include('../partials/header') %>

<div class="mb-4">
    <h2 class="fw-bold">Reports & Analytics</h2>
    <p class="text-muted">Visual insights into gym performance and statistics.</p>
</div>

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Monthly Income (Current Year)</h5>
            </div>
            <div class="card-body">
                <canvas id="incomeChart" height="300"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Plan Distribution</h5>
            </div>
            <div class="card-body">
                <canvas id="planChart" height="300"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Daily Attendance (Last 7 Days)</h5>
            </div>
            <div class="card-body">
                <canvas id="attendanceChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Trainer Performance Monitoring</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Trainer Name</th>
                                <th>Total Clients</th>
                                <th>Sessions Completed</th>
                                <th>Avg Rating</th>
                                <th>Performance Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (trainerStats && trainerStats.length > 0) { %>
                                <% trainerStats.forEach(trainer => { %>
                                    <tr>
                                        <td class="fw-bold"><%= trainer.full_name %></td>
                                        <td><%= trainer.total_clients %></td>
                                        <td><%= trainer.sessions_completed %></td>
                                        <td>
                                            <div class="text-warning">
                                                <% const rating = Math.round(trainer.avg_rating || 0); %>
                                                <% for(let i=1; i<=5; i++) { %>
                                                    <i class="fa<%= i <= rating ? 's' : 'r' %> fa-star small"></i>
                                                <% } %>
                                                <span class="ms-1 text-muted small">(<%= (trainer.avg_rating || 0).toFixed(1) %>)</span>
                                            </div>
                                        </td>
                                        <td>
                                            <% if (trainer.avg_rating >= 4.5) { %>
                                                <span class="badge bg-success">Top Performer</span>
                                            <% } else if (trainer.avg_rating >= 3.5) { %>
                                                <span class="badge bg-info">Good</span>
                                            <% } else if (trainer.avg_rating > 0) { %>
                                                <span class="badge bg-warning">Needs Improvement</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">No Ratings</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No trainer data available.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Income Chart
        const incomeCtx = document.getElementById('incomeChart').getContext('2d');
        new Chart(incomeCtx, {
            type: 'bar',
            data: {
                labels: <%- JSON.stringify(incomeData.map(d => d.month)) %>,
                datasets: [{
                    label: 'Income (₱)',
                    data: <%- JSON.stringify(incomeData.map(d => d.total)) %>,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        // Plan Chart
        const planCtx = document.getElementById('planChart').getContext('2d');
        new Chart(planCtx, {
            type: 'pie',
            data: {
                labels: <%- JSON.stringify(planData.map(d => d.name)) %>,
                datasets: [{
                    data: <%- JSON.stringify(planData.map(d => d.count)) %>,
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.7)',
                        'rgba(75, 192, 192, 0.7)',
                        'rgba(255, 206, 86, 0.7)',
                        'rgba(153, 102, 255, 0.7)'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        // Attendance Chart
        const attendanceCtx = document.getElementById('attendanceChart').getContext('2d');
        new Chart(attendanceCtx, {
            type: 'line',
            data: {
                labels: <%- JSON.stringify(attendanceData.map(d => new Date(d.date).toLocaleDateString())) %>,
                datasets: [{
                    label: 'Check-ins',
                    data: <%- JSON.stringify(attendanceData.map(d => d.count)) %>,
                    borderColor: 'rgba(40, 167, 69, 1)',
                    backgroundColor: 'rgba(40, 167, 69, 0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    });
</script>

<%- include('../partials/footer') %>
