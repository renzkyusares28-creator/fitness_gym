<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Workout Programs</h2>
    <% if (user.role === 'Admin' || user.role === 'Trainer') { %>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addWorkoutModal">
            <i class="fas fa-plus me-2"></i>Assign Workout
        </button>
    <% } %>
</div>

<div class="row">
    <% if (workouts.length > 0) { %>
        <% workouts.forEach(w => { %>
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><%= w.program_name %></h5>
                        <div class="d-flex align-items-center">
                            <span class="badge bg-primary me-2"><%= w.category %></span>
                            <% if (user.role === 'Admin' || user.role === 'Trainer') { %>
                                <div class="dropdown">
                                    <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#editWorkoutModal<%= w.id %>"><i class="fas fa-edit me-2"></i> Edit</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form action="/workouts/delete/<%= w.id %>" method="POST" onsubmit="return confirm('Are you sure?')">
                                                <button type="submit" class="dropdown-item text-danger"><i class="fas fa-trash me-2"></i> Delete</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-2">
                            <i class="fas fa-user me-1"></i> Member: <strong><%= w.member_name %></strong>
                        </p>
                        <p class="text-muted small mb-3">
                            <i class="fas fa-user-tie me-1"></i> Trainer: <strong><%= w.trainer_name || 'System' %></strong>
                        </p>
                        <div class="bg-light p-3 rounded">
                            <p class="mb-0"><%= w.description %></p>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 py-3">
                        <small class="text-muted">Assigned: <%= new Date(w.created_at).toLocaleDateString() %></small>
                    </div>
                </div>
            </div>

            <% if (user.role === 'Admin' || user.role === 'Trainer') { %>
            <!-- Edit Workout Modal -->
            <div class="modal fade" id="editWorkoutModal<%= w.id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">Edit Workout Program</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form action="/workouts/edit/<%= w.id %>" method="POST">
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Select Member</label>
                                    <select name="member_id" class="form-select" required>
                                        <% members.forEach(member => { %>
                                            <option value="<%= member.id %>" <%= w.member_id === member.id ? 'selected' : '' %>><%= member.full_name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <% if (user.role === 'Admin') { %>
                                <div class="mb-3">
                                    <label class="form-label">Assign Trainer</label>
                                    <select name="assigned_by" class="form-select">
                                        <option value="">-- System / No Trainer --</option>
                                        <% trainers.forEach(trainer => { %>
                                            <option value="<%= trainer.id %>" <%= w.assigned_by === trainer.id ? 'selected' : '' %>><%= trainer.full_name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <% } else { %>
                                    <input type="hidden" name="assigned_by" value="<%= w.assigned_by %>">
                                <% } %>
                                <div class="mb-3">
                                    <label class="form-label">Program Name</label>
                                    <input type="text" name="program_name" class="form-control" value="<%= w.program_name %>" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Category</label>
                                    <select name="category" class="form-select" required>
                                        <option value="Weight Loss" <%= w.category === 'Weight Loss' ? 'selected' : '' %>>Weight Loss</option>
                                        <option value="Muscle Gain" <%= w.category === 'Muscle Gain' ? 'selected' : '' %>>Muscle Gain</option>
                                        <option value="Cardio" <%= w.category === 'Cardio' ? 'selected' : '' %>>Cardio</option>
                                        <option value="Strength Training" <%= w.category === 'Strength Training' ? 'selected' : '' %>>Strength Training</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Description / Exercises</label>
                                    <textarea name="description" class="form-control" rows="4" required><%= w.description %></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Update Program</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <% } %>
        <% }) %>
    <% } else { %>
        <div class="col-12 text-center py-5">
            <i class="fas fa-dumbbell fa-4x text-light mb-3"></i>
            <h4 class="text-muted">No workout programs found.</h4>
        </div>
    <% } %>
</div>

<% if (user.role === 'Admin' || user.role === 'Trainer') { %>
<!-- Add Workout Modal -->
<div class="modal fade" id="addWorkoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Assign Workout Program</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/workouts/add" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Member</label>
                        <select name="member_id" class="form-select" required>
                            <option value="">-- Select Member --</option>
                            <% members.forEach(member => { %>
                                <option value="<%= member.id %>"><%= member.full_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% if (user.role === 'Admin') { %>
                    <div class="mb-3">
                        <label class="form-label">Assign Trainer</label>
                        <select name="assigned_by" class="form-select">
                            <option value="">-- System / No Trainer --</option>
                            <% trainers.forEach(trainer => { %>
                                <option value="<%= trainer.id %>"><%= trainer.full_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                    <div class="mb-3">
                        <label class="form-label">Program Name</label>
                        <input type="text" name="program_name" class="form-control" placeholder="e.g. Morning Cardio" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="category" class="form-select" required>
                            <option value="Weight Loss">Weight Loss</option>
                            <option value="Muscle Gain">Muscle Gain</option>
                            <option value="Cardio">Cardio</option>
                            <option value="Strength Training">Strength Training</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description / Exercises</label>
                        <textarea name="description" class="form-control" rows="4" placeholder="List exercises and sets..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Assign Program</button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } %>

<%- include('../partials/footer') %>
