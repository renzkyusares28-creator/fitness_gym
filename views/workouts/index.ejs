<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Workout Programs</h2>
    <% if (user.role === 'Admin' || user.role === 'Trainer') { %>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addWorkoutModal">
            <i class="fas fa-plus me-2"></i>Assign Workout
        </button>
    <% } %>
</div>

<div class="row">
    <% if (workouts.length > 0) { %>
        <% workouts.forEach(w => { %>
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><%= w.program_name %></h5>
                        <span class="badge bg-primary"><%= w.category %></span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-2">
                            <i class="fas fa-user me-1"></i> Member: <strong><%= w.member_name %></strong>
                        </p>
                        <p class="text-muted small mb-3">
                            <i class="fas fa-user-tie me-1"></i> Trainer: <strong><%= w.trainer_name || 'System' %></strong>
                        </p>
                        <div class="bg-light p-3 rounded">
                            <p class="mb-0"><%= w.description %></p>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 py-3">
                        <small class="text-muted">Assigned: <%= new Date(w.created_at).toLocaleDateString() %></small>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="col-12 text-center py-5">
            <i class="fas fa-dumbbell fa-4x text-light mb-3"></i>
            <h4 class="text-muted">No workout programs found.</h4>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
