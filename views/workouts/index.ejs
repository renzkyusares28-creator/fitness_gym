<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Workout Programs</h2>
    <% if (user.role === 'Admin' || user.role === 'Trainer') { %>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addWorkoutModal">
            <i class="fas fa-plus me-2"></i>Assign Workout
        </button>
    <% } %>
</div>

<div class="row">
    <% if (workouts.length > 0) { %>
        <% workouts.forEach(w => { %>
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><%= w.program_name %></h5>
                        <span class="badge bg-primary"><%= w.category %></span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-2">
                            <i class="fas fa-user me-1"></i> Member: <strong><%= w.member_name %></strong>
                        </p>
                        <p class="text-muted small mb-3">
                            <i class="fas fa-user-tie me-1"></i> Trainer: <strong><%= w.trainer_name || 'System' %></strong>
                        </p>
                        <div class="bg-light p-3 rounded">
                            <p class="mb-0"><%= w.description %></p>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 py-3">
                        <small class="text-muted">Assigned: <%= new Date(w.created_at).toLocaleDateString() %></small>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="col-12 text-center py-5">
            <i class="fas fa-dumbbell fa-4x text-light mb-3"></i>
            <h4 class="text-muted">No workout programs found.</h4>
        </div>
    <% } %>
</div>

<% if (user.role === 'Admin' || user.role === 'Trainer') { %>
<!-- Add Workout Modal -->
<div class="modal fade" id="addWorkoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Assign Workout Program</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/workouts/add" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Member</label>
                        <select name="member_id" class="form-select" required>
                            <option value="">-- Select Member --</option>
                            <% members.forEach(member => { %>
                                <option value="<%= member.id %>"><%= member.full_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% if (user.role === 'Admin') { %>
                    <div class="mb-3">
                        <label class="form-label">Assign Trainer</label>
                        <select name="assigned_by" class="form-select">
                            <option value="">-- System / No Trainer --</option>
                            <% trainers.forEach(trainer => { %>
                                <option value="<%= trainer.id %>"><%= trainer.full_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                    <div class="mb-3">
                        <label class="form-label">Program Name</label>
                        <input type="text" name="program_name" class="form-control" placeholder="e.g. Morning Cardio" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="category" class="form-select" required>
                            <option value="Weight Loss">Weight Loss</option>
                            <option value="Muscle Gain">Muscle Gain</option>
                            <option value="Cardio">Cardio</option>
                            <option value="Strength Training">Strength Training</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description / Exercises</label>
                        <textarea name="description" class="form-control" rows="4" placeholder="List exercises and sets..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Assign Program</button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } %>

<%- include('../partials/footer') %>
