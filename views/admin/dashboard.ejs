<%- include('../partials/header') %>

<div class="row mb-4">
    <div class="col">
        <h2 class="fw-bold">Admin Dashboard</h2>
        <p class="text-muted">Welcome back, Admin!</p>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Total Members</h6>
                        <h2 class="mb-0 fw-bold"><%= stats.totalMembers %></h2>
                    </div>
                    <i class="fas fa-users fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Live Capacity</h6>
                        <h2 class="mb-0 fw-bold"><%= stats.currentCapacity %>/50</h2>
                        <small class="opacity-75">Members inside</small>
                    </div>
                    <i class="fas fa-door-open fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Total Trainers</h6>
                        <h2 class="mb-0 fw-bold"><%= stats.totalTrainers %></h2>
                    </div>
                    <i class="fas fa-user-tie fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Monthly Income</h6>
                        <h2 class="mb-0 fw-bold">₱<%= (stats.monthlyIncome || 0).toLocaleString() %></h2>
                    </div>
                    <i class="fas fa-coins fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Recent Members</h5>
                <a href="/members" class="btn btn-sm btn-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Plan</th>
                                <th>Status</th>
                                <th>Joined</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentMembers.length > 0) { %>
                                <% recentMembers.forEach(member => { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="<%= member.profile_picture || 'https://via.placeholder.com/40' %>" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;">
                                                <span class="fw-bold small"><%= member.full_name %></span>
                                            </div>
                                        </td>
                                        <td class="small"><%= member.plan_name || 'N/A' %></td>
                                        <td>
                                            <span class="badge bg-<%= member.status === 'Active' ? 'success' : 'danger' %> extra-small">
                                                <%= member.status %>
                                            </span>
                                        </td>
                                        <td class="small"><%= new Date(member.registration_date).toLocaleDateString() %></td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="/members/edit/<%= member.id %>" class="btn btn-sm btn-outline-primary py-0">
                                                    <i class="fas fa-edit small"></i>
                                                </a>
                                                <a href="/members/delete/<%= member.id %>" class="btn btn-sm btn-outline-danger py-0" onclick="return confirm('Are you sure you want to delete this member and all their records?')">
                                                    <i class="fas fa-trash small"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted small">No members found.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Recent Trainers</h5>
                <a href="/trainers" class="btn btn-sm btn-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Specialization</th>
                                <th>Contact</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentTrainers.length > 0) { %>
                                <% recentTrainers.forEach(trainer => { %>
                                    <tr>
                                        <td class="fw-bold small"><%= trainer.full_name %></td>
                                        <td class="small"><%= trainer.specialization %></td>
                                        <td class="small"><%= trainer.contact_number %></td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="/trainers/edit/<%= trainer.id %>" class="btn btn-sm btn-outline-primary py-0">
                                                    <i class="fas fa-edit small"></i>
                                                </a>
                                                <a href="/trainers/delete/<%= trainer.id %>" class="btn btn-sm btn-outline-danger py-0" onclick="return confirm('Are you sure you want to delete this trainer and their schedules?')">
                                                    <i class="fas fa-trash small"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted small">No trainers found.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Recent Workout Programs</h5>
                <div>
                    <button type="button" class="btn btn-sm btn-success me-2" data-bs-toggle="modal" data-bs-target="#addWorkoutModal">
                        <i class="fas fa-plus small me-1"></i> Assign Workout
                    </button>
                    <a href="/workouts" class="btn btn-sm btn-primary">View All</a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Program</th>
                                <th>Category</th>
                                <th>Member</th>
                                <th>Assigned By</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentWorkouts.length > 0) { %>
                                <% recentWorkouts.forEach(w => { %>
                                    <tr>
                                        <td class="fw-bold small"><%= w.program_name %></td>
                                        <td><span class="badge bg-primary extra-small"><%= w.category %></span></td>
                                        <td class="small"><%= w.member_name %></td>
                                        <td class="small"><%= w.trainer_name || 'System' %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted small">No workout programs found.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Membership Statistics</h5>
            </div>
            <div class="card-body" style="position: relative; height:300px;">
                <canvas id="membershipChart" height="250"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/members/pending" class="btn btn-outline-danger text-start d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-user-clock me-2"></i> Pending Registrations</span>
                        <% if (stats.pendingCount > 0) { %>
                            <span class="badge bg-danger rounded-pill"><%= stats.pendingCount %></span>
                        <% } %>
                    </a>
                    <% if (stats.expiringThisWeek > 0) { %>
                        <div class="alert alert-warning py-2 mb-0 border-0 small">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong><%= stats.expiringThisWeek %></strong> memberships expiring this week.
                        </div>
                    <% } %>
                    <a href="/members/add" class="btn btn-outline-primary text-start">
                        <i class="fas fa-user-plus me-2"></i> Register New Member
                    </a>
                    <a href="/payments/add" class="btn btn-outline-success text-start">
                        <i class="fas fa-money-bill-wave me-2"></i> Record Payment
                    </a>
                    <a href="/attendance/scan" class="btn btn-outline-info text-start">
                        <i class="fas fa-qrcode me-2"></i> Open QR Scanner
                    </a>
                    <button type="button" class="btn btn-outline-success text-start" data-bs-toggle="modal" data-bs-target="#addWorkoutModal">
                        <i class="fas fa-dumbbell me-2"></i> Assign Workout Program
                    </button>
                    <a href="/plans" class="btn btn-outline-warning text-start">
                        <i class="fas fa-tags me-2"></i> Manage Plans
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Workout Modal -->
<div class="modal fade" id="addWorkoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Assign Workout Program</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/workouts/add" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Member</label>
                        <select name="member_id" class="form-select" required>
                            <option value="">-- Select Member --</option>
                            <% members.forEach(member => { %>
                                <option value="<%= member.id %>"><%= member.full_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assign Trainer</label>
                        <select name="assigned_by" class="form-select">
                            <option value="">-- System / No Trainer --</option>
                            <% trainers.forEach(trainer => { %>
                                <option value="<%= trainer.id %>"><%= trainer.full_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Program Name</label>
                        <input type="text" name="program_name" class="form-control" placeholder="e.g. Morning Cardio" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="category" class="form-select" required>
                            <option value="Weight Loss">Weight Loss</option>
                            <option value="Muscle Gain">Muscle Gain</option>
                            <option value="Cardio">Cardio</option>
                            <option value="Strength Training">Strength Training</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description / Exercises</label>
                        <textarea name="description" class="form-control" rows="4" placeholder="List exercises and sets..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Assign Program</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Chart Data -->
<script id="chart-data" type="application/json">
    <%- JSON.stringify(chartData) %>
</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Safe data retrieval from JSON script tag
        const rawData = JSON.parse(document.getElementById('chart-data').textContent);
        const chartMonths = rawData.map(d => d.month);
        const chartCounts = rawData.map(d => d.count);

        const ctx = document.getElementById('membershipChart');
        if (!ctx) return;

        new Chart(ctx.getContext('2d'), {
            type: 'line',
            data: {
                labels: chartMonths,
                datasets: [{
                    label: 'New Memberships',
                    data: chartCounts,
                    borderColor: 'rgb(75, 192, 192)',
                    tension: 0.1,
                    fill: true,
                    backgroundColor: 'rgba(75, 192, 192, 0.2)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    });
</script>

<style>
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
    }
</style>

<%- include('../partials/footer') %>
