<%- include('../../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold">Record Payment</h4>
            </div>
            <div class="card-body p-4">
                <form action="/payments/add" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Select Member</label>
                        <select name="member_id" class="form-select" required>
                            <option value="">-- Select Member --</option>
                            <% members.forEach(member => { %>
                                <option value="<%= member.id %>"><%= member.full_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Select Plan</label>
                        <select name="plan_id" id="plan_select" class="form-select" required>
                            <option value="">-- Select Plan --</option>
                            <% plans.forEach(plan => { %>
                                <option value="<%= plan.id %>" data-price="<%= plan.price %>"><%= plan.name %> (₱<%= plan.price %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Amount Paid (₱)</label>
                        <input type="number" step="0.01" name="amount" id="amount_input" class="form-control" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Payment Method</label>
                        <select name="payment_method" class="form-select" required>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Maya">Maya</option>
                        </select>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary py-2 fw-bold">Confirm Payment</button>
                        <a href="/dashboard" class="btn btn-light py-2 fw-bold">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('plan_select').addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const price = selectedOption.getAttribute('data-price');
        if (price) {
            document.getElementById('amount_input').value = price;
        }
    });
</script>

<%- include('../../partials/footer') %>
