<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Trainer Schedules</h2>
    <% if (user.role === 'Admin') { %>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addScheduleModal">
            <i class="fas fa-plus me-2"></i>Add Schedule
        </button>
    <% } %>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Trainer</th>
                        <th>Member</th>
                        <th>Session Type</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (schedules.length > 0) { %>
                        <% schedules.forEach(s => { %>
                            <tr>
                                <td><%= new Date(s.schedule_date).toLocaleDateString() %></td>
                                <td><%= s.start_time %> - <%= s.end_time %></td>
                                <td><%= s.trainer_name %></td>
                                <td><%= s.member_name %></td>
                                <td>
                                    <span class="badge bg-info text-dark"><%= s.session_type %></span>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No schedules found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
