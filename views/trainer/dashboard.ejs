<%- include('../partials/header') %>

<div class="row mb-4">
    <div class="col">
        <h2 class="fw-bold">Trainer Dashboard</h2>
        <p class="text-muted">Manage your training sessions and members.</p>
    </div>
</div>

<% if (upcomingSessions.length > 0) { %>
    <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="fas fa-bell fa-2x me-3 text-primary"></i>
            <div>
                <h5 class="alert-heading mb-1 fw-bold">Upcoming Sessions Tomorrow!</h5>
                <p class="mb-0">You have <strong><%= upcomingSessions.length %></strong> session(s) scheduled for tomorrow. <a href="/trainers/schedules" class="alert-link">View full schedule</a></p>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Assigned Members</h6>
                        <h2 class="mb-0 fw-bold"><%= stats.assignedMembersCount %></h2>
                    </div>
                    <i class="fas fa-users fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Sessions Today</h6>
                        <h2 class="mb-0 fw-bold"><%= stats.todaySessionsCount %></h2>
                    </div>
                    <i class="fas fa-calendar-day fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1">Quick Actions</h6>
                        <div class="mt-2">
                            <a href="/workouts" class="btn btn-sm btn-light">Assign Workout</a>
                            <a href="/trainers/schedules" class="btn btn-sm btn-outline-light">My Schedule</a>
                        </div>
                    </div>
                    <i class="fas fa-bolt fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Today's Schedule -->
    <div class="col-md-7">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Today's Schedule</h5>
                <span class="badge bg-primary"><%= new Date().toLocaleDateString() %></span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Member</th>
                                <th>Session Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (todaySessions.length > 0) { %>
                                <% todaySessions.forEach(session => { %>
                                    <tr>
                                        <td><%= session.start_time %> - <%= session.end_time %></td>
                                        <td><%= session.member_name %></td>
                                        <td><span class="badge bg-info text-dark"><%= session.session_type %></span></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No sessions scheduled for today.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recently Assigned Workouts -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Recently Assigned Workouts</h5>
                <a href="/workouts" class="btn btn-sm btn-outline-primary small">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Member</th>
                                <th>Program</th>
                                <th>Category</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentWorkouts.length > 0) { %>
                                <% recentWorkouts.forEach(w => { %>
                                    <tr>
                                        <td class="small fw-bold"><%= w.member_name %></td>
                                        <td class="small"><%= w.program_name %></td>
                                        <td><span class="badge bg-primary extra-small" style="font-size: 0.7rem;"><%= w.category %></span></td>
                                        <td>
                                            <div class="btn-group">
                                                <button class="btn btn-sm btn-outline-primary py-0" data-bs-toggle="modal" data-bs-target="#editWorkoutModal<%= w.id %>">
                                                    <i class="fas fa-edit small"></i>
                                                </button>
                                                <form action="/workouts/delete/<%= w.id %>" method="POST" onsubmit="return confirm('Are you sure?')" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 border-start-0">
                                                        <i class="fas fa-trash small"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted small">No workouts assigned yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Assigned Members -->
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">My Assigned Members</h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <% if (assignedMembers.length > 0) { %>
                        <% assignedMembers.forEach(member => { %>
                            <div class="list-group-item d-flex align-items-center">
                                <img src="<%= member.profile_picture || 'https://via.placeholder.com/40' %>" class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;">
                                <div class="flex-grow-1">
                                    <div class="fw-bold"><%= member.full_name %></div>
                                    <small class="text-muted"><%= member.plan_name %></small>
                                </div>
                                <a href="/workouts" class="btn btn-sm btn-outline-primary" title="Assign Workout">
                                    <i class="fas fa-plus"></i>
                                </a>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="p-4 text-center text-muted">No members assigned to you yet.</div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<% if (recentWorkouts.length > 0) { %>
    <% recentWorkouts.forEach(w => { %>
        <!-- Edit Workout Modal for Recent Workouts -->
        <div class="modal fade" id="editWorkoutModal<%= w.id %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Edit Workout Program</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/workouts/edit/<%= w.id %>" method="POST">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Select Member</label>
                                <select name="member_id" class="form-select" required>
                                    <% members.forEach(member => { %>
                                        <option value="<%= member.id %>" <%= w.member_id === member.id ? 'selected' : '' %>><%= member.full_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <input type="hidden" name="assigned_by" value="<%= w.assigned_by %>">
                            <div class="mb-3">
                                <label class="form-label">Program Name</label>
                                <input type="text" name="program_name" class="form-control" value="<%= w.program_name %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Category</label>
                                <select name="category" class="form-select" required>
                                    <option value="Weight Loss" <%= w.category === 'Weight Loss' ? 'selected' : '' %>>Weight Loss</option>
                                    <option value="Muscle Gain" <%= w.category === 'Muscle Gain' ? 'selected' : '' %>>Muscle Gain</option>
                                    <option value="Cardio" <%= w.category === 'Cardio' ? 'selected' : '' %>>Cardio</option>
                                    <option value="Strength Training" <%= w.category === 'Strength Training' ? 'selected' : '' %>>Strength Training</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description / Exercises</label>
                                <textarea name="description" class="form-control" rows="4" required><%= w.description %></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Update Program</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% }) %>
<% } %>

<style>
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
    }
</style>

<%- include('../partials/footer') %>
