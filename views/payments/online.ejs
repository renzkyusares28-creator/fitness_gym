<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold"><i class="fas fa-credit-card me-2 text-primary"></i>Online Membership Renewal</h4>
            </div>
            <div class="card-body p-4">
                <form action="/online-payments/process" method="POST">
                    <div class="mb-4">
                        <label class="form-label fw-bold">Select Membership Plan</label>
                        <div class="row g-3">
                            <% plans.forEach(plan => { %>
                                <div class="col-12">
                                    <input type="radio" class="btn-check" name="plan_id" id="plan<%= plan.id %>" value="<%= plan.id %>" required>
                                    <label class="btn btn-outline-primary w-100 text-start p-3" for="plan<%= plan.id %>">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1 fw-bold"><%= plan.name %></h6>
                                                <small class="opacity-75"><%= plan.duration_months %> Month(s) Access</small>
                                            </div>
                                            <h5 class="mb-0 fw-bold">₱<%= plan.price %></h5>
                                        </div>
                                    </label>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Payment Method</label>
                        <div class="row g-3">
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="payment_method" id="gcash" value="GCash" required>
                                <label class="btn btn-outline-info w-100 p-3" for="gcash">
                                    <i class="fas fa-mobile-alt d-block mb-2 fa-2x"></i>
                                    GCash
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="payment_method" id="maya" value="Maya" required>
                                <label class="btn btn-outline-dark w-100 p-3" for="maya">
                                    <i class="fas fa-wallet d-block mb-2 fa-2x"></i>
                                    Maya
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-secondary small mb-4">
                        <i class="fas fa-info-circle me-2"></i>
                        This is a secure simulated payment. Your membership will be renewed instantly upon clicking the button below.
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Pay & Renew Membership</button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
