<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Trainer Session Bookings</h2>
    <% if (user.role === 'Member') { %>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#bookSessionModal">
            <i class="fas fa-calendar-plus me-2"></i>Book New Session
        </button>
    <% } %>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Trainer</th>
                        <th>Member</th>
                        <th>Workout Type</th>
                        <th>Status</th>
                        <% if (user.role !== 'Member') { %><th>Actions</th><% } %>
                    </tr>
                </thead>
                <tbody>
                    <% if (bookings.length > 0) { %>
                        <% bookings.forEach(booking => { %>
                            <tr>
                                <td><%= new Date(booking.schedule_date).toLocaleDateString() %></td>
                                <td><%= booking.start_time %> - <%= booking.end_time %></td>
                                <td class="fw-bold text-primary"><%= booking.trainer_name %></td>
                                <td><%= booking.member_name %></td>
                                <td><span class="badge bg-info-subtle text-info"><%= booking.session_type %></span></td>
                                <td>
                                    <span class="badge bg-<% 
                                        if(booking.status === 'Confirmed') { %>success<% } 
                                        else if(booking.status === 'Pending') { %>warning<% } 
                                        else { %>danger<% } 
                                    %>">
                                        <%= booking.status %>
                                    </span>
                                </td>
                                <% if (user.role !== 'Member') { %>
                                    <td>
                                        <% if (booking.status === 'Pending') { %>
                                            <form action="/bookings/update-status/<%= booking.id %>" method="POST" class="d-inline">
                                                <input type="hidden" name="status" value="Confirmed">
                                                <button type="submit" class="btn btn-sm btn-success"><i class="fas fa-check"></i></button>
                                            </form>
                                            <form action="/bookings/update-status/<%= booking.id %>" method="POST" class="d-inline">
                                                <input type="hidden" name="status" value="Cancelled">
                                                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-times"></i></button>
                                            </form>
                                        <% } %>
                                    </td>
                                <% } %>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No sessions booked yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<% if (user.role === 'Member') { %>
<!-- Booking Modal -->
<div class="modal fade" id="bookSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Book a Training Session</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/bookings/add" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Trainer</label>
                        <select name="trainer_id" class="form-select" required>
                            <option value="">-- Choose a Trainer --</option>
                            <% trainers.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.full_name %> (<%= t.specialization %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input type="date" name="schedule_date" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Start Time</label>
                        <input type="time" name="start_time" class="form-control" required>
                        <small class="text-muted">Sessions are typically 1 hour long.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Workout Type</label>
                        <input type="text" name="session_type" class="form-control" placeholder="e.g. HIIT, Weightlifting" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary w-100">Request Booking</button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } %>

<%- include('../partials/footer') %>
